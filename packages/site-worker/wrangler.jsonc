// The apex site Worker. Serves clubchatapp.com: the join page, the legal pages, the two
// app-association files, and a landing page.
//
// Read this file beside src/env.ts. Nothing checks the binding and var names in the two against
// each other, so a rename in one and not the other typechecks, deploys, and is `undefined` at the
// edge.
//
// Deployed with `npx wrangler deploy` from packages/site-worker. There are no secrets here and
// there is deliberately no .dev.vars: every value this Worker holds is published in a file it
// serves. See README.md.
{
  "name": "clubchat-site",
  "main": "src/index.ts",

  // The same pinned date as packages/cdn-worker, deliberately, so both edge deployments sit on
  // one runtime baseline and a compatibility-date move is a decision taken once for both rather
  // than drift between them. Pinned rather than tracking for the reason that file states: a
  // compatibility date is the one thing here that changes runtime behaviour with no code change.
  "compatibility_date": "2026-08-21",

  // No nodejs_compat, matching the sibling. Nothing in this package imports `node:` anything, and
  // the absence is what keeps that true: with the shim on, a `Buffer` compiles cleanly here.

  // The legal text is BUNDLED, not fetched. `docs/legal/*.md` are the only copy of that text in
  // the repo (privacy-policy.md and terms-of-service.md), and this rule is what lets `src/legal.ts`
  // import them as strings. Two consequences worth knowing before changing it:
  //
  //  - A change to the legal text is a redeploy of this Worker, not a content edit somewhere. That
  //    is the intended trade: the served text is pinned to a commit and cannot drift from the repo.
  //  - `fallthrough: true` keeps Wrangler's own default rules (Text for **/*.txt and **/*.html,
  //    Data for **/*.bin, CompiledWasm for **/*.wasm) in place. Without it this rule REPLACES the
  //    defaults for its type, which is a silent change to how an unrelated file bundles later.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  // Everything this Worker is configured with is public by construction: it is either printed in a
  // file this Worker serves (the two app ids, the Android fingerprints) or it is a hostname anyone
  // can resolve (the api origin). So `vars` is correct here where it would be a repo-committed
  // skeleton key in packages/cdn-worker. There are no secrets in this Worker and there is nothing
  // for `wrangler secret put` to hold.
  "vars": {
    // Where GET /join/:token reads the club name from. The api's public preview endpoint,
    // GET /invites/:token/preview, which requires no authentication and returns nothing about
    // members. If this is wrong, every join page is the degraded one and nothing else breaks:
    // GET /__parity prints the value so that is one request to confirm.
    "API_ORIGIN": "https://api.clubchatapp.com",

    // TEAMID.BUNDLEID, for /.well-known/apple-app-site-association.
    //
    // The team id is NT7NNC4FJC, supplied by the founder on 2026-08-25. It cannot be derived from
    // this repo and nothing here can check it: apps/mobile/ios is generated by Expo CNG and
    // gitignored, its pbxproj carries no DEVELOPMENT_TEAM, and EAS holds the signing credentials
    // remotely. It is not a secret - it is published in this Worker's own AASA file and in every
    // copy of the app - but it is unverifiable from here, so associations.test.ts pins it and
    // GET /__parity prints it.
    //
    // A wrong team id here is the worst-behaved misconfiguration this Worker has. The AASA file is
    // still valid JSON, Apple still fetches and parses it, and the comparison against the phone's
    // entitlement simply fails: the link opens in Safari, nothing is logged, and nobody is told.
    "IOS_APP_ID": "NT7NNC4FJC.com.parkstechusa.clubchat.remastered",

    // Where a visitor can install the iPhone app. EMPTY ON PURPOSE, and this is the one var that
    // changes what the pages say rather than what they link to.
    //
    // ClubChat has never been released. App Store Connect app id 6804458376 exists, and a record in
    // App Store Connect is not a listing: on 2026-08-25 https://apps.apple.com/app/id6804458376
    // answered 404 and https://itunes.apple.com/lookup?id=6804458376 answered
    // {"resultCount":0,"results":[]}. Distribution is TestFlight internal only. So the store button
    // that used to be built from that id was the join page's primary call to action and it sent a
    // stranger who had just scanned a QR code to an Apple error page.
    //
    // While this is empty, every page says plainly that ClubChat is in private beta and that the
    // way in is the person who invited you, and renders no button rather than an empty button row.
    // Setting it turns the download button back on everywhere at once, with no code change.
    //
    // It holds a URL rather than a store id so that both endings fit: a public App Store listing
    // (https://apps.apple.com/app/id6804458376) and a public TestFlight link
    // (https://testflight.apple.com/join/XXXXXXXX) are the same button pointed somewhere else.
    // Anything that is not an https URL is treated as unset - see installUrl() in src/env.ts.
    "IOS_INSTALL_URL": "",

    // For /.well-known/assetlinks.json. apps/mobile/app.json declares no `android.package` today,
    // so this MIRRORS the iOS bundle id, which is what Expo defaults to. If an Android build ever
    // sets a different package, this var and that file have to move together or Android App Links
    // silently fail to verify.
    "ANDROID_PACKAGE_NAME": "com.parkstechusa.clubchat.remastered",

    // The Android signing certificate SHA-256 fingerprints, comma separated, upper-case hex with
    // colons. EMPTY ON PURPOSE: no Android build has been signed, so there is no fingerprint to
    // publish, and inventing one would serve a file that fails verification while looking correct.
    //
    // While it is empty, /.well-known/assetlinks.json answers `[]` - a valid Digital Asset Links
    // document that states no app is associated - and GET /__parity reports
    // `androidFingerprints: 0`, which is where you look when Android App Links do not verify.
    //
    // Expect TWO values once Play App Signing is on: the upload key and the Play-held app signing
    // key. Both belong here, comma separated.
    "ANDROID_CERT_FINGERPRINTS": ""
  },

  // NO SECOND HOSTNAME. Both default to ON and both are turned off by hand; see the long note in
  // packages/cdn-worker/wrangler.jsonc for the mechanism (`defaultWorkersDev = routes.length === 0`).
  //
  // The reason here is different from the CDN's and weaker, but it is still a reason. This Worker
  // serves the two app-association files, and Apple and Android both fetch those from the exact
  // host in the entitlement. A workers.dev copy of them is an association claim published on a
  // hostname nobody controls the DNS story for, and a preview URL is one per version. Neither is
  // wanted, and neither is needed to test: the apex serves nothing today, so this Worker can be
  // deployed to clubchatapp.com and checked there before anything links to it.
  "workers_dev": false,
  "preview_urls": false,

  // Which build is answering, for GET /__parity. Cloudflare fills this in; there is nothing to set.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Workers Logs, on. Nothing REPORTS an error from this Worker - there is no Sentry at the edge
  // and no alert on a 5xx rate - so this dashboard is the only place an exception here is visible
  // at all. Off by default on new Workers, which is the state that makes a silent gap silent twice.
  "observability": { "enabled": true },

  // The apex. `custom_domain` rather than a plain route, for the same reason the CDN uses one:
  // there is no origin behind clubchatapp.com and never has been, so the Worker has to BE the
  // origin rather than sit in front of one.
  //
  // Attaching it creates the apex DNS record, which today does not exist - the apex serves nothing.
  // A route naming a zone the account does not hold fails `wrangler deploy` outright rather than at
  // request time, so this line is also the assertion that the zone is held. It is, on Cloudflare.
  //
  // `www` is deliberately NOT here. Adding it would mean two hostnames publishing the same
  // association files and two canonical URLs for one invite. If it is ever wanted, the right shape
  // is a redirect rule on the zone pointing www at the apex, not a second route into this Worker.
  "routes": [{ "pattern": "clubchatapp.com", "custom_domain": true }]
}
