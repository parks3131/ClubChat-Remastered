{
  "expo": {
    "name": "ClubChat",
    "slug": "clubchat",
    "owner": "parks3131",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkstechusa.clubchat.remastered"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow ClubChat to save photos from your chats to your photo library.",
          "photosPermission": "Allow ClubChat to access your photos so you can post them in a chat."
        }
      ],
      "@sentry/react-native"
    ],
    "scheme": "clubchat",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "216d5aa2-572c-4d1f-a6e9-5408c82a9b82"
      }
    }
  }
}
