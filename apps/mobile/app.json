{
  "expo": {
    "name": "ClubChat",
    "slug": "clubchat",
    "owner": "parks3131",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/216d5aa2-572c-4d1f-a6e9-5408c82a9b82",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkstechusa.clubchat.remastered",
      "associatedDomains": [
        "applinks:clubchatapp.com"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.parkstechusa.clubchat.remastered",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "clubchatapp.com",
              "pathPrefix": "/join/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow ClubChat to save photos from your chats to your photo library.",
          "photosPermission": "Allow ClubChat to access your photos so you can post them in a chat."
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "clubchat-ef",
          "project": "clubchat-mobile"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ClubChat to use the camera to scan a club QR code.",
          "recordAudioAndVideo": false
        }
      ]
    ],
    "scheme": "clubchat",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "216d5aa2-572c-4d1f-a6e9-5408c82a9b82"
      }
    }
  }
}
