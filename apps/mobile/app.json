{
  "expo": {
    "name": "ClubChat",
    "slug": "clubchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkstechusa.clubchat.remastered"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow ClubChat to save photos from your chats to your photo library.",
          "photosPermission": "Allow ClubChat to access your photos so you can post them in a chat."
        }
      ]
    ],
    "scheme": "clubchat"
  }
}
