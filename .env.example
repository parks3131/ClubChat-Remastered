# Copy to .env for local development. Never commit .env.
#
# AGENTS.md non-negotiable 5: no secrets in the repo. Only keys safe to ship in a
# client belong anywhere near version control. Every value below is a local
# development placeholder and none of them are real.

# --- Postgres (docker compose up -d postgres) ---
DATABASE_URL=postgresql://clubchat:clubchat@localhost:5432/clubchat

# --- Redis (docker compose up -d redis) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# better-auth signs sessions with this. Generate a real one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=dev-only-not-a-secret-regenerate-me
BETTER_AUTH_URL=http://localhost:3000

# --- Object storage (docker compose up -d minio) ---
# S3-compatible. Production is Cloudflare R2, chosen for zero egress because media
# egress is the dominant variable cost.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=clubchat
S3_SECRET_ACCESS_KEY=clubchat-dev-secret
# Two buckets, and the split is the point. Identity media (avatars) is public with a
# stable path. Content media (chat photos, documents, news photos) is PRIVATE and only
# ever reachable through the authorized redirect at GET /media/:id.
S3_BUCKET_PUBLIC=clubchat-identity
S3_BUCKET_PRIVATE=clubchat-content

# Signs the hour-aligned media URLs. Distinct from BETTER_AUTH_SECRET: a leak of one
# must not become a leak of the other.
MEDIA_SIGNING_SECRET=dev-only-not-a-secret-regenerate-me
# Where signed media URLs point, in cdn mode only.
#
# Parsed and validated at boot in BOTH modes, because one flat schema serves all three roles,
# and never read in presign mode. So this needs to be URL-shaped and nothing more here.
#
# It must carry NO path in production. `signedMediaUrl` joins it to the object key raw, and the
# key alone is what the signature covers, so a prefix would have to be stripped again at the edge
# before the HMAC could be recomputed. The old value here baked the PRIVATE bucket name into the
# path, which additionally sent every avatar key at the wrong bucket.
MEDIA_CDN_BASE_URL=http://media.invalid/unused-in-presign-mode

# --- Outbound mail ---
# Both are OPTIONAL, and leaving them unset is the normal local setup: with no key the
# API runs LoggingMailer, which writes the password-reset email - reset URL included -
# to the process log. That is what makes the whole flow testable on a laptop with no
# provider account and no DNS. Production refuses to boot this way (ADR-0019).
#
# To send real mail from here instead, put a Resend key below. MAIL_FROM's domain must
# be verified in the Resend dashboard or the send is rejected. Set BOTH or NEITHER -
# a key with no MAIL_FROM fails at startup on purpose.
# Quote MAIL_FROM: node's --env-file does not need it, but the angle brackets are
# shell redirection to anything that sources this file.
# RESEND_API_KEY=re_your_key_here
# MAIL_FROM="ClubChat <noreply@your-verified-domain.com>"
#
# The other direction: what Resend tells us happened to a message afterwards. Copy this
# from the webhook's page in the Resend dashboard - it is the "whsec_" value, and it is
# NOT the API key above. Unset, POST /webhooks/resend refuses every delivery with a 503
# and says so once, because with no secret it cannot tell Resend from anybody else. A
# value that does not decode fails at startup on purpose (ADR-0047).
# RESEND_WEBHOOK_SECRET=whsec_your_signing_secret_here

# --- Process ports ---
API_PORT=3000
GATEWAY_PORT=3001

# --- Client origin, for CORS ---
CLIENT_ORIGIN=http://localhost:8081

# --- Rate limiting (SPEC/TECH/05-authorization.md: burst 30, refill 1/sec) ---
SEND_RATE_BURST=30
SEND_RATE_REFILL_PER_SEC=1

# --- Log level ---
LOG_LEVEL=debug

# --- Proxies in front of the API ---
# Decides what request.ip is, which is what keys the per-IP sign-in bucket - the one rate
# limit here that is a security control rather than an abuse ceiling.
#
#   false  no proxy. Development, and anywhere the process is directly reachable. The default.
#   1      one hop. Correct on Fly.io, where the edge proxy is the only way in.
#   true   trust every hop. Only when nothing can reach the process directly.
#          Set on a directly reachable process, any caller can forge X-Forwarded-For and get a
#          fresh bucket per request, which removes the limit rather than loosening it.
#
# Left unset behind a proxy, every caller shares the proxy's address and one bucket covers the
# whole internet - which fails closed rather than open, and is still useless as protection.
TRUST_PROXY=false

# cdn (production, a signature-validating Worker fronts the buckets) | presign (no CDN)
#
# presign HERE, and this is not a preference. CI copies this file to .env and boots a live api
# from it, and there is no CDN in front of MinIO. In cdn mode the api hands out a URL carrying
# `exp` and `sig`, MinIO has never heard of either, and the fetch is an unauthenticated GET on
# private content - correctly refused with 403. Every private object would be unreachable while
# every server test stayed green, because nothing in CI fetches media bytes.
MEDIA_URL_MODE=presign

# --- Platform moderation ---
#
# Who may read the direct-message report queue: a comma-separated list of email addresses.
#
# A platform moderator is an OPERATOR, not a product role. Nobody earns this by using ClubChat -
# somebody holds it because they run the service - which is why it is configured here rather than
# granted from inside the app. The API reconciles users.is_platform_moderator against this list at
# boot, so revoking somebody is deleting them from this line rather than remembering an inverse
# command, and it survives a restore or a db:nuke.
#
# An address that matches no account is named in the boot log rather than passing silently.
#
# LEAVING THIS EMPTY NEVER REVOKES ANYBODY. Reconciling to zero moderators would mean DM reports
# arrive and nobody can read them, which Apple's guideline 1.2 forbids - and an absent secret after
# a deploy looks exactly like a deliberate empty list. Unset logs a warning and changes nothing.
PLATFORM_MODERATORS=

# --- Error monitoring (SPEC/TECH/15: "in the error path from the first commit") ---
#
# All three optional. With no DSN the capture paths still run and report to the process
# logger, which is deliberate: it means they are exercised on every dev run and in CI
# rather than firing for the first time in production. Paste a real DSN to send them on.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
#
# How much of the traffic is TIMED, between 0 and 1. Errors are unaffected by it and are always
# sent in full; this only decides how many timings are kept.
#
# A tenth, matching what all three fly/*.toml set, and the number is a cost decision rather than a
# technical one. At one live club it is a few hundred traces a day, which is enough to see a
# pattern and small enough that nobody has to think about the bill; 1.0 on a live system is a bill
# nobody has agreed to.
#
# Empty means the same as absent and both fall back to 0.1, which is what makes a bare key here
# safe. A value that is not a number, `off` say, is a boot failure naming this field on purpose:
# tracing was already silent once because a constant in the code said zero, and a config that read
# a typo as zero would put the same silence one layer down, where it looks configured.
#
# In production this is a dial rather than a rebuild: `fly secrets set
# SENTRY_TRACES_SAMPLE_RATE=0.01` and a restart turns it down without shipping code.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set by the deploy, not by hand. Ties a stack trace to the commit it came from.
SENTRY_RELEASE=

# --- The phone's own crash reporting ---
#
# A SEPARATE Sentry project from the server's above, deliberately: Sentry projects are
# platform-typed, and a React Native project gets source maps, release health and a crash UI
# built for mobile that a Node project does not. It also keeps a crash loop on one phone from
# burying server 5xx in a shared quota.
#
# EXPO_PUBLIC_ because it is inlined into the client bundle, which is safe here and only here:
# a DSN is a write-only ingest address, so holding it lets somebody send events to the project
# and never read them. The token that uploads source maps is a real secret and does not belong
# in this file or in the repo.
#
# Empty is a supported state. The client reports to the console instead, so every capture call
# site runs on every dev launch rather than first executing in production.
EXPO_PUBLIC_SENTRY_DSN=
#
# Optional. The environment is normally derived from the build itself - a dev build reports as
# `development`, a release build as `production` - so there is nothing to remember and nothing to
# get wrong. Set this only for a build that is neither, a TestFlight one being the obvious case.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
#
# How much of the phone's activity is TIMED, as SENTRY_TRACES_SAMPLE_RATE above decides for the
# api. A tenth when unset, matching the three server roles, because both halves of the system
# report into one Sentry organisation and therefore into one quota.
#
# Unlike the server's, this cannot be turned down without shipping a build: an EXPO_PUBLIC_ value
# is inlined into the JavaScript bundle at build time rather than read at boot, and a phone has no
# environment to restart into. Empty falls back to the tenth rather than meaning zero - see
# apps/mobile/src/trace-rate.ts, where that trap is the whole reason the value is parsed instead
# of read.
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
