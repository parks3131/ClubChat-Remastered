# Copy to .env for local development. Never commit .env.
#
# AGENTS.md non-negotiable 5: no secrets in the repo. Only keys safe to ship in a
# client belong anywhere near version control. Every value below is a local
# development placeholder and none of them are real.

# --- Postgres (docker compose up -d postgres) ---
DATABASE_URL=postgresql://clubchat:clubchat@localhost:5432/clubchat

# --- Redis (docker compose up -d redis) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# better-auth signs sessions with this. Generate a real one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=dev-only-not-a-secret-regenerate-me
BETTER_AUTH_URL=http://localhost:3000

# --- Process ports ---
API_PORT=3000
GATEWAY_PORT=3001

# --- Client origin, for CORS ---
CLIENT_ORIGIN=http://localhost:8081

# --- Rate limiting (SPEC/TECH/05-authorization.md: burst 30, refill 1/sec) ---
SEND_RATE_BURST=30
SEND_RATE_REFILL_PER_SEC=1

# --- Log level ---
LOG_LEVEL=debug
