{
  "name": "clubchat",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d --wait postgres redis minio && node scripts/wait-for-services.mjs",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:generate": "npm run db:generate -w @clubchat/server --",
    "db:migrate": "npm run db:migrate -w @clubchat/server",
    "db:prove": "npm run db:prove -w @clubchat/server",
    "db:stats": "npm run db:stats -w @clubchat/server",
    "db:stats:reset": "npm run db:stats:reset -w @clubchat/server",
    "gate:surface": "bash scripts/surface-gate.sh",
    "load:test": "npm run load:test -w @clubchat/server",
    "dev:api": "npm run dev:api -w @clubchat/server",
    "dev:gateway": "npm run dev:gateway -w @clubchat/server",
    "dev:worker": "npm run dev:worker -w @clubchat/server",
    "dev:mobile": "npm run start -w @clubchat/mobile",
    "lint:emdash": "node scripts/check-emdash.mjs",
    "check:runtime": "node scripts/check-node-parse.mjs",
    "check:pods": "node scripts/check-pods.mjs",
    "ios": "node scripts/check-pods.mjs && npm run ios -w @clubchat/mobile",
    "verify": "npm run typecheck && npm run check:runtime && npm run lint:emdash && npm run check:pods && npm test"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
