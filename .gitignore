learnings/

# dependencies
node_modules/

# secrets - AGENTS.md non-negotiable 5
#
# Deny every .env and allow back the one template, rather than listing the spellings we
# happened to think of. The list here was `.env`, `.env.local` and `.env.*.local` until
# 2026-08-08, and `.env.bak` matched none of them - so a backup taken beside a real value was
# committed and stayed committed. The leak that mattered was the pattern, not that file: it
# held a placeholder. A denylist of guessed suffixes is the wrong shape for secrets.
.env*
!.env.example

# build output
dist/
build/
*.tsbuildinfo

# expo
.expo/
web-build/

# test and tooling
coverage/
.playwright-mcp/

# The dev trace's session recordings. Development traffic, but it carries real message
# bodies and real user ids, so it is never a thing to commit.
.dev-trace/

# os
.DS_Store

# Local agent settings. Untracked because it accumulates one-off dev commands,
# including bearer tokens from smoke tests against the local database.
.claude/settings.local.json

# Wrangler's local state, and the Worker's local secrets.
#
# `.dev.vars` is the Worker's equivalent of `.env` and holds a real MEDIA_SIGNING_SECRET,
# but it does NOT start with `.env`, so the deny-everything rule above does not cover it.
# Same shape as the `.env.bak` leak that rule was written for: a secret file whose spelling
# nobody had thought of. The template is allowed back, as `.env.example` is.
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
